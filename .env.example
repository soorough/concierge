ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
MODEL_PROVIDER=anthropic
MODEL_NAME=claude-haiku-4-5-20251001
CONSOLE_PASSWORD=
# Local development only. A relative path resolves inside the working directory, which on a
# deployed container means the database is erased by the next deploy — mounting a volume does
# not help if nothing points at it. In production set an absolute path inside the mount,
# e.g. DB_PATH=/data/concierge.db, and check /api/health reports storage.persistent = true.
DB_PATH=./data/concierge.db
PORT=3000
PUBLIC_URL=http://localhost:3000
DAILY_SPEND_CAP_CENTS=500
SESSION_TURN_CAP=40
SESSION_INGEST_CAP=5
MAX_MESSAGE_CHARS=2000
MAX_LINE_QTY=24
