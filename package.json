{
  "name": "concierge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc -p tsconfig.json && cp store/*.sql dist/store/ && npm --prefix console ci && npm --prefix console run build",
    "start": "node dist/server/index.js",
    "evals": "tsx evals/run.ts",
    "stress": "tsx evals/adversarial.ts",
    "db:reset": "rm -f data/concierge.db && tsx store/migrate.ts",
    "restart": "scripts/restart.sh",
    "monitor": "tsx evals/monitor.ts",
    "build:deploy": "npm run build && rm -rf console/node_modules && npm prune --omit=dev",
    "numbers": "tsx evals/numbers.ts",
    "live": "tsx evals/live.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@fastify/static": "^7.0.4",
    "better-sqlite3": "^11.5.0",
    "fastify": "^4.28.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
